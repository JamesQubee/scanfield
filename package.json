{
  "name": "scanfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scanfield: a mobile-first football decision game. Scan before you receive, then tap where the ball goes.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5540 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5541 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply scanfield --local",
    "scenarios": "node --experimental-strip-types scripts/scenario-report.ts",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.14.0",
    "@types/three": "0.186.0",
    "lil-gui": "0.21.0",
    "posthog-js": "1.438.12",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
